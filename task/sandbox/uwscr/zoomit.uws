//
// zoomitを制御する関数群
//
module zoomit
  //
  const timeout = 100       // timeout待ち時間[sec] 
  //
  function init()
  //
  // zoomitの起動
    exec("C:\download\zoomit64.exe")
    zid = getid("Zoomit License Agreement",,timeout)
    clkitem(zid,"Agree",CLK_BTN)  // Licenseの承認ボタン
    zid = getid("Zoomit - Sysinternals",,timeout)
    clkitem(zid,"OK",CLK_BTN)     // 設定のOKボタン
    result = TRUE
  fend

  function mode(flag)
    //
    // Zoomit の動作モード変更
    //
    if flag then
      // Ctrl+2 キーの押下
      KBD(VK_CONTROL,DOWN,100)
      KBD(VK_2,CLICK,100)
      KBD(VK_CONTROL,UP)
    else
      // Esc キーの押下
      KBD(VK_ESCAPE,100)
    endif
    result = TRUE
  fend

  function line(x,y,x2,y2)
    //
    // 線引き
    MMV(x2,y2)             //マウスを終点に
    KBD(VK_SHIFT,DOWN,100) //shiiftキー
    BTN(LEFT,DOWN,100)     //マウス左キー
    MMV(x,y,100)           //マウスを始点に
    sleep(0.1)
    BTN(LEFT,UP,100)       //マウス左キー戻し
    KBD(VK_SHIFT,UP,100)   //shiiftキー戻し
    result = TRUE
  fend
endmodule
