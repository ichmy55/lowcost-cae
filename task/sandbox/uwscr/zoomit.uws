//
// zoomitを制御する関数群
//
module zoomit
  //
  const timeout = 100       // timeout待ち時間[sec] 
  //
  function init()
  //
  // zoomitの起動
    exec("C:\download\zoomit64.exe")
    zid = getid("Zoomit License Agreement",,timeout)
    clkitem(zid,"Agree",CLK_BTN)  // Licenseの承認ボタン
    zid = getid("Zoomit - Sysinternals",,timeout)
    clkitem(zid,"OK",CLK_BTN)     // 設定のOKボタン
    result = TRUE
  fend

  function mode(flag)
    //
    // Zoomit の動作モード変更
    //
    if flag then  // Ctrl+2 キーの押下
      KBD(VK_CONTROL,DOWN,100)
      KBD(VK_2,CLICK,100)
      KBD(VK_CONTROL,UP)
      doscmd("echo qwe1 > \output\qwe1.txt")
      print "QWE1"
      sleep(10)
      doscmd("echo qwe2 > \output\qwe2.txt")
      print "QWE2"
    else
      SCKEY(0,VK_ESCAPE)        // Esc キーの押下
    endif
    result = TRUE
  fend

  function line(x,y)
    //
    // 線引き
    result = TRUE
  fend
endmodule
