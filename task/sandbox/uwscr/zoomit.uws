//
// zoomitを制御する関数群
//
module zoomit
  //
  const timeout       =  30  // timeout待ち時間[sec] 
  const wait_sec      = 0.1  // wait待ち時間[sec] 
  const wait_msec     = 100  // wait待ち時間[msec] 
  const conf_m        = "準備ができたら、ALTキーを押してください" // 確認要求
  const conf_font     = "メイリオ"                               // 確認要求のフォント
  const conf_fontsize = "16"                                     // 確認要求のフォントサイズ
  const confirm_x = 250
  const confirm_y = 950
  const term_x = 1920
  const term_y = 1080
  //
  function init()
  //
  // zoomitの起動
    exec("C:\download\zoomit64.exe")
    zid = getid("Zoomit License Agreement",,timeout)
    clkitem(zid,"Agree",CLK_BTN)         // Licenseの承認ボタン
    zid = getid("Zoomit - Sysinternals",,timeout)
    clkitem(zid,"Type",CLK_TAB)          // Typeタグを選択
    sleep(wait_sec)
    clkitem(zid,"Font",CLK_LEFTCLK)  // Fontボタンをクリック
    sleep(wait_sec)
    zid2 = getid("Zoomit Font",,timeout)
    sendstr(zid2,conf_font)
    sendstr(zid2,conf_fontsize,3,true)
    clkitem(zid2,"OK",CLK_BTN)     //フォント設定画面OKボタン
    clkitem(zid,"OK",CLK_BTN)      // 設定のOKボタン
    lid = 0
    repeat
      lid = lid + 1
      sleep(wait_sec)
      zid = getid("Zoomit - Sysinternals",,wait_sec)
    UNTIL ((zid < 0) or (lid > timeout/wait_sec )) // Zoomit設定画面が閉じるまで待つ

    result = TRUE
  fend

  function mode(flag)
    //
    // Zoomit の動作モード変更
    //
    select flag
      case 0
        // Esc キーの押下
        KBD(VK_ESCAPE,CLICK,wait_msec)
      case 2
        // Ctrl+2 キーの押下
        KBD(VK_CONTROL,DOWN,wait_msec)
        KBD(VK_2,DOWN,wait_msec)
        sleep(0.5)
        KBD(VK_2,CLICK,wait_msec)
        KBD(VK_2,UP)
        KBD(VK_CONTROL,UP)
    SELEND
    result = TRUE
  fend

  function line(x,y,x2,y2)
    //
    // 線引き
    this.mode(2)
    KBD(VK_R,CLICK,wait_msec)           //文字色を赤に
    MMV(x2,y2)                   //マウスを終点に
    KBD(VK_SHIFT,DOWN,wait_msec) //shiiftキー
    BTN(LEFT,DOWN,,,wait_msec)   //マウス左キー
    MMV(x,y,wait_msec)           //マウスを始点に
    BTN(LEFT,UP,,,wait_msec)     //マウス左キー戻し
    KBD(VK_SHIFT,UP,wait_msec)   //shiiftキー戻し
    sleep(wait_sec)
    result = TRUE
  fend

  function arrow(x,y,x2,y2)
    //
    // 矢印線引き
    print "QWE7="+x+","+y+","+x2+","+y2
    this.mode(2)
    KBD(VK_R,CLICK,wait_msec)        //文字色を赤に
    MMV(x2,y2)                   //マウスを終点に
    KBD(VK_CTRL,DOWN,wait_msec)  //controlキー
    KBD(VK_SHIFT,DOWN,wait_msec) //shiiftキー
    BTN(LEFT,DOWN,,,wait_msec)   //マウス左キー
    BTN(LEFT,DOWN,x2,y2,wait_msec)   //マウス左キー
    MMV(x,y,wait_msec)           //マウスを始点に
    BTN(LEFT,UP,x,y,wait_msec)       //マウス左キー戻し
    KBD(VK_SHIFT,UP,wait_msec)   //shiiftキー戻し
    KBD(VK_CTRL,UP,wait_msec)    //controlキー戻し
    sleep(wait_sec)
    result = TRUE
  fend

  function box(x,y,x2,y2)
    //
    // 四角形線引き
    this.mode(2)
    KBD(VK_R,CLICK,wait_msec)        //文字色を赤に
    MMV(x2,y2)                       //マウスを終点に
    KBD(VK_CTRL,DOWN,wait_msec)      //controlキー
    BTN(LEFT,DOWN,x2,y2,wait_msec)   //マウス左キー
    MMV(x,y,wait_msec)               //マウスを始点に
    BTN(LEFT,UP,x,y,wait_msec)       //マウス左キー戻し
    KBD(VK_CTRL,UP,wait_msec)        //controlキー戻し
    sleep(wait_sec)
    result = TRUE
  fend

  function confirm1()
    //
    // 次進んでよいかを聞く(初回）
    if (modef == modeconst[0] ) THEN
      BTN(LEFT,UP)                                 // 左クリックの押上げ
      BTN(LEFT,UP,confirm_x,confirm_y,wait_msec)   // 左クリックの押上げ
      this.mode(2)
      KBD(VK_SHIFT,DOWN,wait_msec)        //shiiftキー
      KBD(VK_G,CLICK,wait_msec)           //文字色を緑に
      KBD(VK_SHIFT,UP,wait_msec)          //shiiftキー
      BTN(LEFT,CLICK,confirm_x,confirm_y,wait_msec)   // マウスを始点へ
      KBD(VK_T,CLICK,wait_msec)           //Tキー
      sleep(wait_sec)
      KBD(VK_DOWN,CLICK,wait_msec)        //下矢印キー
      KBD(VK_DOWN,CLICK,wait_msec)        //下矢印キー
      KBD(VK_DOWN,CLICK,wait_msec)        //下矢印キー
      KBD(conf_m,CLICK,wait_msec)         //確認メッセージ
      BTN(RIGHT,CLICK,term_x,term_y,wait_msec)          // 右クリックの押下
      lid = 0
      repeat
        lid = lid + 1
        sleep(0.1)
      UNTIL (getkeystate(VK_ALT) or (lid > waitsec * 10))
    ENDIF
    this.mode(0)
    showbeak.clean()
    result = TRUE
  fend

  function confirm2()
    //
    // 次進んでよいかを聞く
    if (modef == modeconst[0] ) THEN
      this.mode(2)
      BTN(LEFT,UP)                                 // 左クリックの押上げ
      BTN(LEFT,UP,confirm_x,confirm_y,wait_msec)   // 左クリックの押上げ
      KBD(VK_SHIFT,DOWN,wait_msec)        //shiiftキー
      KBD(VK_G,CLICK,wait_msec)           //文字色を緑に
      KBD(VK_SHIFT,UP,wait_msec)          //shiiftキー
      KBD(VK_T,CLICK,wait_msec)           //Tキー
      sleep(wait_sec)
      KBD(conf_m,CLICK,wait_msec)         //確認メッセージ
      BTN(RIGHT,CLICK,term_x,term_y,wait_msec)          // 右クリックの押下
      lid = 0
      repeat
        lid = lid + 1
        sleep(0.1)
      UNTIL (getkeystate(VK_ALT) or (lid > waitsec * 10))
    ENDIF
    this.mode(0)
    showbeak.clean()
    result = TRUE
  fend
endmodule
