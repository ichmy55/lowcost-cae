//
OPTION GUIPRINT
OPTION LOGFILE = 4
OPTION LOGPATH = "C:\output\uwscr.log"
//
// 大域定数
//
const  waitsec          = 10          // クリック待ちする秒数
const  waitsec2         = 600         // ファイルダウンロード待ちする秒数
const  confirm          = "準備ができたら、左クリックしてください" // 確認要求
const  csv_filename     = "commands.csv" 
const  debugconst       = "debug" 
const  initial_url      = "about:blank" 
public modeconst        = ["step","through","video"] 
public delta            = [[0,70],[0,70],[0,-70],[60,69],[0,69],[0,70],[0,70],[0,70],[-60,69],[0,69]]
public delta2           = [[0,70],[0,70],[0,-70],[0,70],[0,70],[0,70],[0,70],[0,70],[60,70],[0,70]]
public bgColor          = [$FFFFE0, $E0FFFF] // 文字背景色
//
// 大域変数
//
public breaker = 0       // スレッド停止要求フラグ
public debugf  = false   // デバッグ表示要求フラグ
public modef             // 動作モードフラグ
public command_list = [] // 本UWSに対する動作指示
public command_num       // 上記行数
public fname    = EMPTY  // 結果画像名
public fnamenum = 0      // 結果画像連番
public xnow = 0          // 最終ポインタ位置X
public ynow = 0          // 最終ポインタ位置Y
public builder 
public msedge  
public tab
//
// タイトル帯の表示関数
//
CALL get_param.uws
CALL edge.uws
CALL showbeak.uws
CALL dispatcher.uws
CALL ppink.uws
//
// メイン処理
//
// 初期設定
print "Debug start"
LOGPRINT(debugf,1100,400)
getparam.get_parameter(PARAM_STR)
getparam.get_commands()
ppink.init()
//
// コマンドを順次実行
//
dispatcher.selector()
//
sleep(10)
showbeak.save_image()
print "Debug ends"
