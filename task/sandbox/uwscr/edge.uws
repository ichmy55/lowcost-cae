//
// Edge 起動
//
PROCEDURE start_edge
  builder = BrowserBuilder(BC_MSEDGE)
  msedge  = builder.start()
  ctrlwin(msedge.id(),MAX)
  if msedge.count > 0 then
    tab = msedge[0]
  else
    tab = msedge.new("about:blank")
  endif
  tab.navigate(initial_url)
  //ctrlwin(msedge.id(),TOPMOST)
  //ctrlwin(msedge.id(),ACTIVATE)
FEND
//
// Edge にURL入力
//
PROCEDURE url_edge(st)
  tab.navigate(st)
FEND
//
// Edge にカーソル移動してクリック
//
PROCEDURE mouth_edge(x: number, y: number)
  MMV(x,y)
  BTN(LEFT,CLICK)
FEND
//
// Edge 下方向スクロール
//
PROCEDURE scroll_edge(n: number)
  ctrlwin(msedge.id(),ACTIVATE)
  for lid = 0 to  10 
    BTN(WHEEL,n/10,500,500,100)
  next
  tab.wait()
  sleep(0.5)
FEND
//
// Edge にカーソル移動
//
PROCEDURE keyimage_edge(st)
  st = "C:\script\keyimage\"+st
  pt = SearchImage(st,95,1)
  x = pt[0][0] +100
  y = pt[0][1] +20
  BTN(LEFT,CLICK,x,y)
  print "QWE8"
  print x
  print y
FEND
//
// Edge にカーソル移動
//
PROCEDURE move_edge(x: number, y: number)
  MMV(x,y)
FEND
