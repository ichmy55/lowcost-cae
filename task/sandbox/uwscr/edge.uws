module edge
//
  const wait_sec      = 0.1  // wait待ち時間[sec]
  const wait_msec     = 100  // wait待ち時間[msec]
  PUBLIC tab
//
// Edge 起動
//
  function init()
    builder = BrowserBuilder(BC_MSEDGE)
    msedge  = builder.start()
    ctrlwin(msedge.id(),MAX)
    if msedge.count > 0 then
      tab = msedge[0]
    else
      tab = msedge.new("about:blank")
    endif
    tab.navigate(initial_url)
    RESULT=true
  FEND
//
// Edge にURL入力
//
  function url_edge(st)
    tab.navigate(st)
    RESULT=true
  FEND
//
// Edge にカーソル移動してクリック
//
  function mouth_edge(x: number, y: number)
    MMV(x,y)
    BTN(LEFT,CLICK,x,y,wait_msec)
    sleep(wait_sec)
    BTN(LEFT,CLICK,x,y,wait_msec)
    tab.wait()
    RESULT=true
  FEND
//
// Edge にーソル移動してクリック
//
  function tabclick_edge(st)
    lid = 0
    repeat
      lid = lid + 1
      sleep(wait_sec)
    UNTIL (BRSetData(tab, TRUE, st) or (lid > waitsec2 / wait_sec))
    RESULT=true
  FEND
//
// Edge 下方向スクロール
//
  function scroll_edge(n: number)
    ctrlwin(msedge.id(),ACTIVATE)
    for lid = 0 to  10 
      BTN(WHEEL,n/10,500,500,100)
    next
    tab.wait()
    sleep(0.5)
    RESULT=true
  FEND
//
// イメージに一致する箇所をクリック
//
  function keyimage_edge(st)
    st = "C:\script\keyimage\"+st
    pt = SearchImage(st,95,1)
    x = pt[0][0] +100
    y = pt[0][1] +20
    BTN(LEFT,CLICK,x,y,wait_msec)
    RESULT=true
  FEND
//
// イメージ出現待ち
//
  function waitkey_edge(st)
    st = "C:\script\keyimage\"+st
    lid = 0
    repeat
      pt = SearchImage(st,95,1)
      lid = lid + 1
      sleep(0.1)
    UNTIL (LENGTH(pt) >=1) or (lid > waitsec2 * 10)
    RESULT=true
  FEND
//
// Edge にカーソル移動
//
  function move_edge(x: number, y: number)
    MMV(x,y)
    RESULT=true
  FEND
//
// ドラッグ移動
//
  function drug(x: number, y: number)
    BTN(LEFT, UP,,,100)
    BTN(LEFT, DOWN,,,100)
    MMV(x,y)
    BTN(LEFT, DOWN,200,200,100)
    BTN(LEFT, UP,,,100)
    RESULT=true
  FEND

endmodule
